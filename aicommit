#!/bin/bash
set -e

# aicommit - Auto-generate commit messages using opencode AI
# Usage: aicommit [-n|--dry-run] [git commit options]

DRY_RUN=false
ARGS=()

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run)
            DRY_RUN=true
            ;;
        *)
            ARGS+=("$arg")
            ;;
    esac
done

COMMITS_TEMPLATE="$HOME/COMMITS.md"
MODEL="${AICOMMIT_MODEL:-openai/gpt-5.6-luna}"

# Check if we're in a git repository
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Error: Not a git repository" >&2
    exit 1
fi

# Check if there are staged changes
if git diff --cached --quiet; then
    echo "Error: No staged changes to commit" >&2
    echo "Stage your changes first with: git add <files>" >&2
    exit 1
fi

# Get the staged diff
if ! DIFF=$(git diff --cached --stat && echo "---" && git diff --cached); then
    echo "Error: Failed to read staged diff" >&2
    exit 1
fi

# Read commit template if exists
TEMPLATE=""
if [[ -f "$COMMITS_TEMPLATE" ]]; then
    TEMPLATE=$(cat "$COMMITS_TEMPLATE")
fi

# Generate commit message using opencode
PROMPT="Generate a git commit message for the following changes.

$TEMPLATE

Here is the diff of staged changes:

$DIFF

Output ONLY the commit message, nothing else. No explanations, no markdown formatting, no code blocks."

if ! COMMIT_MSG=$(opencode run -m "$MODEL" "$PROMPT"); then
    echo "Error: opencode failed to generate commit message" >&2
    exit 1
fi

if [[ -z "$COMMIT_MSG" ]]; then
    echo "Error: Failed to generate commit message" >&2
    exit 1
fi

# Dry run: just show the message
if $DRY_RUN; then
    echo "$COMMIT_MSG"
    exit 0
fi

# Commit with the generated message (using stdin for proper multiline support)
echo "$COMMIT_MSG" | git commit --file=- "${ARGS[@]}"

# Show full commit message
echo ""
echo "Full commit message:"
echo "---------------"
echo "$COMMIT_MSG"
echo "---------------"
